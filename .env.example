# 从阿里云百炼控制台取得；不要把真实密钥提交到仓库。
DASHSCOPE_API_KEY=

# 默认按华北2（北京）配置；API Key 必须在同一地域创建。
# 生产环境建议把它替换为创建 Key 时弹窗提供的业务空间专属 API Host：
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 新加坡示例：https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 2026-09-22 官方文档当前推荐的音视频理解模型；若账号可用型号不同，可在本机覆盖。
QWEN_OMNI_MODEL=qwen3.8-omni-flash

# ffmpeg 可执行文件绝对路径；若已加入 PATH 可留空。
FFMPEG_PATH=

MODEL_TIMEOUT_SECONDS=240
